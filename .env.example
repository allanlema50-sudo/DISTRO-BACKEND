# Copy this file to .env for Docker Compose. Never commit the real .env file.

POSTGRES_DB=distro_backend
POSTGRES_USER=distro
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5433

# Host port for the API. The application always listens on 8080 in the container.
API_PORT=8080

# Must be a strong base64-encoded secret. Generate one with:
# PowerShell: $b=[byte[]]::new(64); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-a-64-byte-base64-secret
JWT_ISSUER=logiflow
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Use local for development; set to prod in a real deployment so provider
# integrations do not use development adapters.
SPRING_PROFILES_ACTIVE=local

# First platform administrator bootstrap. Keep disabled after the account is created.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=
BOOTSTRAP_SUPER_ADMIN_PHONE=

# Comma-separated browser origins used by frontend development. For Render,
# replace these with the exact frontend origins (not the backend URL).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
OPENAPI_ENABLED=true
FRONTEND_BASE_URL=http://localhost:4200

# Optional onboarding email delivery. Keep disabled for local development
# unless a local SMTP sink such as MailHog is running.
MAIL_ENABLED=false
MAIL_FROM=no-reply@logiflow.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
ONBOARDING_ACTIVATION_TTL=24h
ONBOARDING_INVITATION_TTL=7d

# Unpaid order reservation controls. Reservations expire and are released
# automatically; the per-customer limit prevents a single customer from
# holding excessive inventory concurrently.
ORDER_DELIVERY_FEE=200.00
ORDER_RESERVATION_TTL=15m
ORDER_MAX_OPEN_PENDING_PER_CUSTOMER=5
ORDER_RESERVATION_EXPIRY_SCAN_MS=60000
ORDER_RESERVATION_EXPIRY_BATCH_SIZE=100

# Set true only once for a reviewed pre-Flyway database that already contains
# the V1 schema. Leave false for new databases and production by default.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# Daraja/M-Pesa. Keep these values out of Git. Use sandbox values locally and
# production credentials only through the deployment secret manager.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_SHORTCODE=replace-with-daraja-shortcode
MPESA_PASSKEY=replace-with-daraja-passkey
MPESA_CALLBACK_URL=https://replace-with-a-public-host/api/v1/payments/mpesa/callback
MPESA_CALLBACK_SECRET=replace-with-a-random-callback-secret
# Must remain true. The API rejects callbacks when provider verification is disabled.
MPESA_VERIFY_CALLBACK=true
MPESA_FINAL_FAILURE_RESULT_CODES=1032
MPESA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_CONNECT_TIMEOUT=3s
MPESA_READ_TIMEOUT=10s

# Production OTP provider adapter. Required only with SPRING_PROFILES_ACTIVE=prod.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SMS_ENDPOINT=https://replace-with-sms-provider/messages
OTP_SMS_API_KEY=replace-with-sms-provider-api-key
OTP_SMS_SENDER_ID=LogiFlow
