# Copy this file to .env for Docker Compose. Never commit the real .env file.

POSTGRES_DB=distro_backend
POSTGRES_USER=distro
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5433

# Host port for the API. The application always listens on 8080 in the container.
API_PORT=8080

# Must be a strong base64-encoded secret. Generate one with:
# PowerShell: $b=[byte[]]::new(64); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-a-64-byte-base64-secret
JWT_ISSUER=logiflow
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Use local for development. Production deployments MUST set this to prod so
# callback hardening and ProductionDemoFlagGuard apply.
SPRING_PROFILES_ACTIVE=local

# Controlled platform administrator bootstrap. Keep disabled except during a
# deliberate create or reconciliation operation.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=
BOOTSTRAP_SUPER_ADMIN_PHONE=

# Comma-separated browser origins used by frontend development. For Render,
# replace these with the exact frontend origins (not the backend URL).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
OPENAPI_ENABLED=true
FRONTEND_BASE_URL=http://localhost:4200

# Product images are private and capped at 5 MiB by the database schema.
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880
ACCESS_REQUEST_DOCUMENT_MAX_FILE_SIZE=5MB
ACCESS_REQUEST_MAX_REQUEST_SIZE=12MB

# Optional onboarding email delivery. Keep disabled for local development
# unless a local SMTP sink such as MailHog is running.
MAIL_ENABLED=false
MAIL_FROM=no-reply@logiflow.local
MAIL_HOST=
MAIL_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
ONBOARDING_ACTIVATION_TTL=24h
ONBOARDING_INVITATION_TTL=7d
ONBOARDING_SUBMISSION_WINDOW=15m
ONBOARDING_MAX_SUBMISSIONS_PER_WINDOW=100
ONBOARDING_MAX_DOCUMENT_STORAGE=1GB
ONBOARDING_DOCUMENT_RETENTION=30d
ONBOARDING_DOCUMENT_RETENTION_SCAN_MS=86400000
ONBOARDING_DOCUMENT_RETENTION_INITIAL_DELAY_MS=60000
# Public access-request evidence limits. Each certificate is PDF/JPG/PNG and
# is stored privately; the request limit includes both files and multipart overhead.
# Unpaid order reservation controls. Reservations expire and are released
# automatically; the per-customer limit prevents a single customer from
# holding excessive inventory concurrently.
ORDER_DELIVERY_FEE=200.00
ORDER_RESERVATION_TTL=15m
ORDER_MAX_OPEN_PENDING_PER_CUSTOMER=5
ORDER_RESERVATION_EXPIRY_SCAN_MS=60000
ORDER_RESERVATION_EXPIRY_BATCH_SIZE=100
PURCHASE_ORDER_FULFILMENT_RECOVERY_SCAN_MS=60000

# Set true only once for a reviewed pre-Flyway database that already contains
# the V1 schema. Leave false for new databases and production by default.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# Daraja/M-Pesa. Keep these values out of Git. Use sandbox values locally and
# production credentials only through the deployment secret manager.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_SHORTCODE=replace-with-daraja-shortcode
MPESA_PASSKEY=replace-with-daraja-passkey
# The API appends ?token=$MPESA_CALLBACK_SECRET when it registers the STK callback.
# Do not put the secret in this URL. Production must also set MPESA_CALLBACK_ALLOWED_IPS
# to Safaricom's current callback addresses. Behind Render, MPESA_CALLBACK_TRUSTED_PROXY_COUNT=1.
MPESA_CALLBACK_URL=https://replace-with-a-public-host/api/v1/payments/mpesa/callback
# Marketplace checkout STK callbacks use their dedicated public endpoint.
MPESA_CHECKOUT_CALLBACK_URL=https://replace-with-a-public-host/api/v1/checkouts/mpesa/callback
MPESA_CALLBACK_SECRET=replace-with-a-random-callback-secret
# Comma-separated Safaricom callback source addresses. Required when the prod profile is active.
MPESA_CALLBACK_ALLOWED_IPS=
MPESA_CALLBACK_IP_ALLOWLIST_REQUIRED=false
MPESA_CALLBACK_TRUSTED_PROXY_COUNT=0
# The prod profile forces this off. Safaricom cannot send the header.
MPESA_CALLBACK_HEADER_SECRET_ENABLED=true
# Must remain true. The API rejects callbacks when provider verification is disabled.
MPESA_VERIFY_CALLBACK=true
MPESA_FINAL_FAILURE_RESULT_CODES=1032
# Optional endpoint overrides. Normally leave unset so each endpoint follows MPESA_BASE_URL.
# If overriding for a special deployment, all three must use the same Daraja environment.
# MPESA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
# MPESA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
# MPESA_STK_QUERY_URL=https://sandbox.safaricom.co.ke/mpesa/stkpushquery/v1/query
MPESA_CONNECT_TIMEOUT=3s
MPESA_READ_TIMEOUT=10s

# Paystack hosted checkout. Keep disabled until Paystack test credentials and
# the webhook signing secret have been configured in the deployment secret store.
PAYSTACK_ENABLED=false
PAYSTACK_TRANSFERS_ENABLED=false
# Require Super Admin review before a new organization payout destination is activated.
PAYSTACK_BENEFICIARY_REVIEW_REQUIRED=false
# TEST-only convenience: auto-create an auditable payout batch after confirmed receipt and hold.
PAYSTACK_TEST_AUTO_SETTLEMENT_ENABLED=false
PAYSTACK_TEST_AUTO_SETTLEMENT_SCAN_MS=30000
PAYSTACK_TEST_AUTO_SETTLEMENT_BATCH_SIZE=50
SUPPLIER_SETTLEMENT_DELIVERY_HOLD_DAYS=7
PAYSTACK_MODE=test
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=replace-with-paystack-test-or-live-secret-key
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-signing-secret
PAYSTACK_CALLBACK_URL=https://replace-with-a-public-frontend-or-backend-callback
PAYMENT_WEBHOOK_POLL_INTERVAL_MS=2000
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_WEBHOOK_BATCH_SIZE=25
PAYMENT_WEBHOOK_PROCESSING_TIMEOUT=5m
PAYSTACK_RECONCILIATION_SCAN_MS=60000
PAYSTACK_CUSTOMER_ORDER_REVIEW_AFTER_HOURS=24
PAYSTACK_SETTLEMENT_RECONCILIATION_SCAN_MS=60000
PAYSTACK_SETTLEMENT_RECONCILIATION_BATCH_SIZE=100
PAYSTACK_SETTLEMENT_RECONCILIATION_INITIAL_DELAY_MS=300000
PAYSTACK_SETTLEMENT_RECONCILIATION_REPEAT_DELAY_MS=300000

# Marketplace checkout is intentionally disabled until explicitly enabled for
# the deployment. Enabling checkout does not enable demo payment or supplier
# split payouts. Demo checkout payments are simulated, explicitly allowlisted,
# and controlled only by this flag; they never transfer real money.
LOGIFLOW_MARKETPLACE_CHECKOUT_ENABLED=false
LOGIFLOW_DEFAULT_COMMISSION_PERCENT=5.00
LOGIFLOW_DEMO_PAYMENTS_ENABLED=false
LOGIFLOW_DEMO_ORGANIZATION_IDS=
LOGIFLOW_DEMO_PAYMENT_OUTCOME=SUCCESS
LOGIFLOW_DEMO_PAYMENT_DELAY_SECONDS=3
# Demo customer fulfillment (skip M-Pesa + admin demo-dispatch). Must stay false
# in production; the prod profile refuses to start when this is true.
APP_DEMO_CUSTOMER_FULFILLMENT=false

# Production OTP provider adapter. Required only with SPRING_PROFILES_ACTIVE=prod.
# Select one production adapter: http (SMS), resend (Resend email), or mailgun (Mailgun API).
# OTP provider adapter. http (SMS), resend, mailgun, and brevo send a real code.
# mailgun and brevo deliver the code with the EMAIL_PROVIDER transport below.
# Leave http for local development; the local profile prints the email and OTP.
OTP_PROVIDER=http
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SMS_ENDPOINT=https://replace-with-sms-provider/messages
OTP_SMS_API_KEY=replace-with-sms-provider-api-key
OTP_SMS_SENDER_ID=LogiFlow
# Required only when OTP_PROVIDER=resend.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
# Required only when OTP_PROVIDER=mailgun. The sandbox allows up to 5 verified recipients.
MAILGUN_API_KEY=replace-with-mailgun-api-key
MAILGUN_DOMAIN=replace-with-mailgun-sandbox-domain
MAILGUN_API_BASE_URL=https://api.mailgun.net

# HTTPS email transport for OTP and onboarding mail: mailgun, brevo, or log.
# log prints the recipient, subject, body, and OTP to the console. The app
# refuses to start with log unless SPRING_PROFILES_ACTIVE=local.
# Brevo is HTTP (https://api.brevo.com/v3/smtp/email), not SMTP. Render's free
# tier blocks outbound SMTP ports, so do not point this at MAIL_HOST.
EMAIL_PROVIDER=mailgun
# Required when EMAIL_PROVIDER=brevo. BREVO_SENDER_EMAIL must be a verified Brevo sender.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-verified-brevo-sender
BREVO_SENDER_NAME=Distro
